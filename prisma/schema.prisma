generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// USER MODEL
// ===============================

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  password    String

  location    String?
  address     String?

  role        Role     @default(CUSTOMER)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders       Order[]
  cartItems    CartItem[]
  wishlist     Wishlist[]

  products     Product[] @relation("VendorProducts")
}

// ===============================
// PRODUCT MODEL
// ===============================

model Product {
  id              String   @id @default(cuid())

  name            String
  slug            String   @unique

  description     String?

  price           Float
  originalPrice   Float?

  currency        String   @default("KES")

  image           String
  gallery         String[]

  category        String
  brand           String?

  discount        Float?

  stock           Int      @default(0)

  featured        Boolean  @default(false)
  trending        Boolean  @default(false)
  imported        Boolean  @default(false)

  freeDelivery    Boolean  @default(false)

  deliveryFee     Float?
  estimatedDelivery String?

  rating          Float    @default(0)
  reviews         Int      @default(0)

  shopLocation    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorId        String?
  vendor          User? @relation(
    "VendorProducts",
    fields: [vendorId],
    references: [id]
  )

  cartItems       CartItem[]
  wishlist        Wishlist[]
  orderItems      OrderItem[]
}

// ===============================
// CART MODEL
// ===============================

model CartItem {
  id          String   @id @default(cuid())

  quantity    Int      @default(1)

  userId      String
  productId   String

  user         User    @relation(fields: [userId], references: [id])
  product      Product @relation(fields: [productId], references: [id])

  createdAt    DateTime @default(now())
}

// ===============================
// WISHLIST MODEL
// ===============================

model Wishlist {
  id          String   @id @default(cuid())

  userId      String
  productId   String

  user         User    @relation(fields: [userId], references: [id])
  product      Product @relation(fields: [productId], references: [id])

  createdAt    DateTime @default(now())
}

// ===============================
// ORDER MODEL
// ===============================

model Order {
  id              String   @id @default(cuid())

  userId          String

  subtotal        Float
  deliveryFee     Float
  total           Float

  paymentMethod   PaymentMethod

  orderStatus     OrderStatus @default(PENDING)

  trackingNumber  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id])

  items           OrderItem[]
}

// ===============================
// ORDER ITEM MODEL
// ===============================

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  productId   String

  quantity    Int
  price       Float

  order       Order @relation(fields: [orderId], references: [id])

  product     Product @relation(fields: [productId], references: [id])
}

// ===============================
// ENUMS
// ===============================

enum Role {
  ADMIN
  CUSTOMER
  VENDOR
}

enum PaymentMethod {
  MPESA
  CARD
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}
